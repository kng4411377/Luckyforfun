            "additionalProperties": true
          },
          "authStatus": {
            "type": "object",
            "properties": {
              "authenticated": {
                "type": "boolean",
                "description": "Authentication status"
              },
              "competing": {
                "type": "boolean",
                "description": "Whether there's a competing session"
              },
              "connected": {
                "type": "boolean",
                "description": "Connection status"
              }
            },
            "additionalProperties": true
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Available trading accounts"
          }
        }
      },
      "IBKRAuthErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Authentication required"
          },
          "message": {
            "type": "string",
