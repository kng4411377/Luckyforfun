          },
          "health": {
            "type": "object",
            "description": "IB Gateway health check results",
            "additionalProperties": true
          },
          "authStatus": {
            "type": "object",
            "description": "Authentication status details",
            "additionalProperties": true
          },
          "connected": {
            "type": "boolean",
            "description": "Overall connection status"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
