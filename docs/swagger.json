                  },
                  "currency": {
                    "type": "string",
                    "example": "USD"
                  }
                }
              },
              "TotalCashValue": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "description": "Total cash value",
                    "example": "85000.00"
                  },
                  "currency": {
                    "type": "string",
                    "example": "USD"
                  }
                }
              }
            },
            "additionalProperties": {
              "type": "object"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data retrieval timestamp"
          }
        }
      },
      "IBKRConnectResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
